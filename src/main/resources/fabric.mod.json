{
  "schemaVersion": 1,
  "id": "linguachat",
  "version": "${version}",
  "name": "LinguaChat",
  "description": "Automatic translation of chat messages between players using Google Translate, DeepL, and Kagi Translate",
  "authors": [
    "Lintech"
  ],
  "contact": {
    "homepage": "https://github.com/Lintech-1/LinguaChat",
    "sources": "https://github.com/Lintech-1/LinguaChat",
    "issues" : "https://github.com/Lintech-1/LinguaChat/issues"
  },
  "license": "MIT",
  "icon": "assets/linguachat/linguachat.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.linguachat.LinguaChatMod"
    ],
    "client": [
      "com.linguachat.LinguaChatClient"
    ],
    "modmenu": [
      "com.linguachat.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "linguachat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "${fabric_api_mod_id}": ">=${fabric_api_version}"
  }
} 
